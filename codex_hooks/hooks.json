{
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 ~/.codex/hooks/profile_hook.py",
            "timeout": 30,
            "statusMessage": "Logging user prompt"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash|apply_patch|Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "python3 ~/.codex/hooks/profile_hook.py",
            "timeout": 30,
            "statusMessage": "Logging tool start"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash|apply_patch|Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "python3 ~/.codex/hooks/profile_hook.py",
            "timeout": 30,
            "statusMessage": "Logging tool result"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 ~/.codex/hooks/profile_hook.py",
            "timeout": 30,
            "statusMessage": "Logging turn stop"
          }
        ]
      }
    ]
  }
}
